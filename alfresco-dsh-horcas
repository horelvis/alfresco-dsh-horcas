#!/usr/bin/env sh
#
# alfresco-dsh-horcas: lanza el agente de migracion de Alfresco (plugin dsh-alfresco-migrator) sobre
# DeepSeek Harness como un comando mas (al estilo opencode / codex / claude).
#
#   alfresco-dsh-horcas "analiza en solo lectura la migracion de data/projects/example.yaml"   # headless
#   alfresco-dsh-horcas web [--port 8080] [--no-open]                                         # UI web
#
# Carga `.env`, construye el plugin si falta `dist/`, mapea el modelo a `DEEPSEEK_*` y arranca dsh con
# el plugin (capa del perfil si esta instalado; si no, `--patch ./cordis.yml`). Aprobacion de escrituras
# por defecto `deny` (fail-closed); en web usa MIGRATOR_APPROVAL=interactive para aprobar en la UI.
set -eu

# Resuelve el directorio real del comando aunque se invoque via symlink (npm link / PATH).
SELF=$0
while [ -h "$SELF" ]; do
  LINK=$(ls -ld "$SELF" | sed 's/.* -> //')
  case "$LINK" in
    /*) SELF=$LINK ;;
    *) SELF=$(dirname "$SELF")/$LINK ;;
  esac
done
ROOT=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)

# 1) Configuracion local (no versionada): `.env` del proyecto actual o del paquete.
#    Copia .env.example a .env y rellena (credenciales del origen y modelo).
ENV_FILE=""
if [ -f "$PWD/.env" ]; then
  ENV_FILE="$PWD/.env"
elif [ -f "$ROOT/.env" ]; then
  ENV_FILE="$ROOT/.env"
fi
if [ -n "$ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1091
  . "$ENV_FILE"
  set +a
fi

# 2) Construye el plugin a demanda.
if [ ! -f "$ROOT/dist/index.js" ]; then
  echo "[alfresco-dsh-horcas] construyendo el plugin..." >&2
  ( cd "$ROOT" && npm install && npm run build )
fi

# 3) El agente dsh usa DEEPSEEK_*; reutilizamos la config del modelo del .env.
export DEEPSEEK_API_KEY="${DEEPSEEK_API_KEY:-${OPENAI_API_KEY:-}}"
export DEEPSEEK_BASE_URL="${DEEPSEEK_BASE_URL:-${OPENAI_BASE_URL:-}}"
export DEEPSEEK_DEFAULT_MODEL="${DEEPSEEK_DEFAULT_MODEL:-${OPENAI_CHAT_OPTIONS_MODEL:-deepseek-v4.1-flash}}"

# Personalizacion de la UI web (titulo de la pestana).
export DSH_CLIENT_TITLE="${DSH_CLIENT_TITLE:-Alfresco DSH Horcas}"
# El sidebar muestra la etiqueta "DSH Local Build" (fallback de build no oficial).
# Para mostrar el brand oficial de dsh en lugar de esa etiqueta, descomenta:
# export DSH_CLIENT_BUILD_PROFILE=official

# 4) Datos de dominio (del paquete) y estado (del proyecto actual).
export MIGRATOR_DATA_DIR="${MIGRATOR_DATA_DIR:-$ROOT/data}"
export MIGRATOR_STATE="${MIGRATOR_STATE:-$PWD/.migrator}"
# Solo-migracion: deniega tools ajenas (bash/fs/...) salvo ask_user. Pon false para uso general.
export MIGRATOR_STRICT_TOOLS="${MIGRATOR_STRICT_TOOLS:-true}"

usage() {
  echo "uso: alfresco-dsh-horcas [web [--port N] [--no-open]]   # UI web (por defecto)" >&2
  echo "     alfresco-dsh-horcas headless \"<tarea>\"               # una tarea, no interactivo" >&2
  echo "ej.: alfresco-dsh-horcas \"analiza en solo lectura la migracion de data/projects/example.yaml\"" >&2
}

# Aprobacion por defecto segun modo: web -> interactive (responde la UI); headless -> deny.
approval_default() {
  if [ -z "${MIGRATOR_APPROVAL+x}" ]; then
    case "$1" in
      web) export MIGRATOR_APPROVAL=interactive ;;
      *) export MIGRATOR_APPROVAL=deny ;;
    esac
  fi
}

# Arranca dsh (binario global o via npx).
run_dsh() {
  if command -v dsh >/dev/null 2>&1; then
    exec dsh "$@"
  fi
  echo "[alfresco-dsh-horcas] 'dsh' no esta en el PATH; usando npx @deepseek-ai/dsh" >&2
  exec npx --yes @deepseek-ai/dsh "$@"
}

# True si el plugin ya esta registrado como capa del perfil (`dsh plugin add`).
plugin_installed() {
  manifest="$HOME/.dsh/profiles/$1/package.json"
  [ -f "$manifest" ] && grep -q '"dsh-plugin-alfresco-migrator"' "$manifest" 2>/dev/null
}

# Lanza un perfil: sin --patch si el plugin ya esta instalado en el; con --patch si no.
launch() {
  prof="$1"
  shift
  approval_default "$prof"
  if plugin_installed "$prof"; then
    run_dsh --profile "$prof" "$@"
  else
    run_dsh --profile "$prof" --patch "$ROOT/cordis.yml" "$@"
  fi
}

# Lanza la UI web anadiendo hosts de confianza (el fence /api compara la authority).
# Sin esto, abrir con `localhost` cuando el bind es `127.0.0.1` (o al reves) rompe el
# directory picker con "Failed to fetch".
launch_web() {
  case " $* " in
    *" --trusted-host "*) ;;
    *) set -- "$@" --trusted-host localhost --trusted-host 127.0.0.1 ;;
  esac
  launch web "$@"
}

case "${1:-}" in
  help|-h|--help)
    cat <<'EOF'
alfresco-dsh-horcas — agente de migracion de Alfresco (plugin dsh-alfresco-migrator) sobre DeepSeek Harness

INSTALAR (repo privado: gh autenticado o credenciales git)
  gh repo clone horelvis/dsh-alfresco-migrator ~/.local/share/alfresco-dsh-horcas -- --depth 1
  ~/.local/share/alfresco-dsh-horcas/install.sh
  # o, en un paso (bootstrap remoto autenticado con gh):
  curl -fsSL -H "Authorization: Bearer $(gh auth token)" \
    https://raw.githubusercontent.com/horelvis/dsh-alfresco-migrator/main/bootstrap.sh | sh
  # o, desde el repo ya clonado:
  ./install.sh                 dependencias + build + bundle en el perfil dsh + comando global
  cp .env.example .env         rellena credenciales del origen y modelo (o crea .env en tu proyecto)
  # sin instalar, desde el repo:  ./alfresco-dsh-horcas ...

EJECUTAR
  alfresco-dsh-horcas                 # abre la UI web (por defecto)
  alfresco-dsh-horcas web [--port 8080] [--no-open]
  alfresco-dsh-horcas headless "<tarea>"   # una tarea, no interactivo
  alfresco-dsh-horcas "analiza en solo lectura la migracion de data/projects/example.yaml"

APROBACION DE ESCRITURAS (MIGRATOR_APPROVAL)
  web:      interactive (defecto; aprueba en la UI) | deny | allowlist | allow
  headless: deny (defecto, fail-closed) | allowlist | allow

ALCANCE
  Por defecto SOLO-MIGRACION: toda tool ajena (bash/fs/web/...) se deniega, salvo ask_user.
  Permitir alguna herramienta:  MIGRATOR_STRICT_ALLOW=bash,read
  Uso general (sin limite):     MIGRATOR_STRICT_TOOLS=false
EOF
    exit 0
    ;;
  web|--web)
    shift
    launch_web "$@"
    ;;
  headless|--headless)
    shift
    [ "$#" -gt 0 ] || { usage; exit 2; }
    launch headless "$@"
    ;;
  "")
    # Sin argumentos: abre la UI web (UX recomendada).
    launch_web
    ;;
  *)
    [ "$#" -gt 0 ] || { usage; exit 2; }
    launch "${DSH_PROFILE:-headless}" "$@"
    ;;
esac
