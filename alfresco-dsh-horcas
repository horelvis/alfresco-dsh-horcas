#!/usr/bin/env sh
#
# alfresco-dsh-horcas: lanza el agente de migracion de Alfresco (plugin dsh-alfresco-migrator) sobre
# DeepSeek Harness como un comando mas (al estilo opencode / codex / claude).
#
#   alfresco-dsh-horcas "analiza en solo lectura la migracion de data/projects/example.yaml"   # headless
#   alfresco-dsh-horcas web [--port 8080] [--no-open]                                         # UI web
#
# Carga `.env`, construye el plugin si falta `dist/`, mapea el modelo a `DEEPSEEK_*` y arranca dsh con
# el plugin (capa del perfil si esta instalado; si no, `--patch ./cordis.yml`). Aprobacion de escrituras
# por defecto `deny` (fail-closed); en web usa MIGRATOR_APPROVAL=interactive para aprobar en la UI.
set -eu

# Resuelve el directorio real del comando aunque se invoque via symlink (npm link / PATH).
SELF=$0
while [ -h "$SELF" ]; do
  LINK=$(ls -ld "$SELF" | sed 's/.* -> //')
  case "$LINK" in
    /*) SELF=$LINK ;;
    *) SELF=$(dirname "$SELF")/$LINK ;;
  esac
done
ROOT=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)

# 1) Configuracion: DEFAULTS GLOBALES (opcional) + `.env` del WORKSPACE actual (nunca la del repo del
#    producto). El global vive en $ALFRESCO_DSH_HORCAS_ENV o ~/.config/alfresco-dsh-horcas/env y sirve
#    para valores comunes a todos los workspaces (p.ej. DSH_BIN, MIGRATOR_MODE, aprobacion, modelo).
#    El `.env` del workspace manda sobre el global. Lo EXPLICITO manda sobre ambos: una variable ya
#    exportada al invocar (p.ej. MIGRATOR_APPROVAL=allowlist) NO la pisan los ficheros (se restauran las
#    exportadas previas tras cargarlos).
GLOBAL_ENV="${ALFRESCO_DSH_HORCAS_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/alfresco-dsh-horcas/env}"
# Si el workspace no tiene `.env`, se CREA desde `.env.example`: el workspace queda listo y solo hay que
# rellenar credenciales/modelo. Si no hay YAML de proyecto, el AGENTE lo crea con `migrator_wizard`.
if [ ! -f "$PWD/.env" ] && [ -f "$ROOT/.env.example" ]; then
  if cp "$ROOT/.env.example" "$PWD/.env" 2>/dev/null; then
    echo "[alfresco-dsh-horcas] creado $PWD/.env desde .env.example (rellena origen, destino y modelo)." >&2
  fi
fi
if [ -f "$GLOBAL_ENV" ] || [ -f "$PWD/.env" ]; then
  _preset=$(export -p)
  set -a
  # shellcheck disable=SC1091
  if [ -f "$GLOBAL_ENV" ]; then . "$GLOBAL_ENV"; fi
  # shellcheck disable=SC1091
  if [ -f "$PWD/.env" ]; then . "$PWD/.env"; fi
  set +a
  eval "$_preset"
  unset _preset
else
  echo "[alfresco-dsh-horcas] AVISO: no hay .env en el workspace ($PWD) ni defaults globales ($GLOBAL_ENV)." >&2
  echo "[alfresco-dsh-horcas] copia $ROOT/.env.example a $PWD/.env y rellena (origen, destino, modelo)." >&2
fi

# 2) Construye el plugin a demanda.
if [ ! -f "$ROOT/dist/index.js" ]; then
  echo "[alfresco-dsh-horcas] construyendo el plugin..." >&2
  ( cd "$ROOT" && npm install && npm run build )
fi

# 3) Credenciales/endpoint del LLM: dsh usa DEEPSEEK_*; reutilizamos la config del .env.
#    OJO: el modelo del AGENTE lo fija el arnes (`agent-default-model` = deepseek-official/deepseek-v4.1-flash,
#    override en ~/.dsh/profiles/<perfil>/cordis.patch.yml); DEEPSEEK_DEFAULT_MODEL solo lo usa la busqueda web.
export DEEPSEEK_API_KEY="${DEEPSEEK_API_KEY:-${OPENAI_API_KEY:-}}"
export DEEPSEEK_BASE_URL="${DEEPSEEK_BASE_URL:-${OPENAI_BASE_URL:-}}"
export DEEPSEEK_DEFAULT_MODEL="${DEEPSEEK_DEFAULT_MODEL:-${OPENAI_CHAT_OPTIONS_MODEL:-deepseek-v4.1-flash}}"
# Provider pi-ai 'opencode-go' (config de modelos del arnes): reutiliza la misma clave/endpoint.
export OPENCODE_GO_API_KEY="${OPENCODE_GO_API_KEY:-${OPENAI_API_KEY:-}}"

# Personalizacion de la UI web (titulo de la pestana).
export DSH_CLIENT_TITLE="${DSH_CLIENT_TITLE:-Alfresco DSH Horcas}"
# El sidebar muestra la etiqueta "DSH Local Build" (fallback de build no oficial).
# Para mostrar el brand oficial de dsh en lugar de esa etiqueta, descomenta:
# export DSH_CLIENT_BUILD_PROFILE=official

# 4) Datos de dominio (del paquete) y estado (del proyecto actual).
export MIGRATOR_DATA_DIR="${MIGRATOR_DATA_DIR:-$ROOT/data}"
export MIGRATOR_STATE="${MIGRATOR_STATE:-$PWD/.migrator}"
# Guardrail solo-migracion: permite lectura/inspeccion, ejecucion por shell, mutacion de ficheros y
# orquestacion; deniega solo la RED arbitraria (web_fetch/web_search).
# Pon false para uso general; amplia con MIGRATOR_GUARDRAIL_ALLOW=bash,read.
export MIGRATOR_GUARDRAIL="${MIGRATOR_GUARDRAIL:-true}"
# Solo-lectura (determinista): las tools de ESCRITURA del migrador se DENIEGAN. Para el ensayo real
# hay que habilitar explicitamente la escritura: MIGRATOR_MODE=write (y la aprobacion que corresponda).
export MIGRATOR_MODE="${MIGRATOR_MODE:-readonly}"
# Sandbox de ficheros del arnes: `read-only` => toda escritura/borrado (bash rm, write/edit, redirecciones)
# queda BLOQUEADO y escala a aprobacion humana (`ask`). NO usar `workspace-write` (permite borrados dentro
# del workspace sin preguntar) ni `danger-full-access` (aprobacion `never`). Es la garantia "todo borrado
# lo confirma un humano", independiente del prompt.
export DSH_PERMISSION_MODE="${DSH_PERMISSION_MODE:-read-only}"

usage() {
  echo "uso: alfresco-dsh-horcas [web [--port N] [--no-open]]   # UI web (por defecto)" >&2
  echo "     alfresco-dsh-horcas headless \"<tarea>\"               # una tarea, no interactivo" >&2
  echo "ej.: alfresco-dsh-horcas \"analiza en solo lectura la migracion de data/projects/example.yaml\"" >&2
}

# Aprobacion por defecto segun modo: web -> interactive (responde la UI); headless -> deny.
approval_default() {
  if [ -z "${MIGRATOR_APPROVAL+x}" ]; then
    case "$1" in
      web) export MIGRATOR_APPROVAL=interactive ;;
      *) export MIGRATOR_APPROVAL=deny ;;
    esac
  fi
}

# Arranca dsh: DSH_BIN (p.ej. un arnes custom del fork) > `dsh` del PATH > npx.
run_dsh() {
  if [ -n "${DSH_BIN:-}" ]; then
    # shellcheck disable=SC2086  # DSH_BIN puede ser "node /ruta/bin.js"
    exec $DSH_BIN "$@"
  fi
  if command -v dsh >/dev/null 2>&1; then
    exec dsh "$@"
  fi
  echo "[alfresco-dsh-horcas] 'dsh' no esta en el PATH; usando npx @deepseek-ai/dsh" >&2
  exec npx --yes @deepseek-ai/dsh "$@"
}

# True si el plugin ya esta registrado como capa del perfil (`dsh plugin add`).
plugin_installed() {
  manifest="$HOME/.dsh/profiles/$1/package.json"
  [ -f "$manifest" ] && grep -q '"dsh-plugin-alfresco-migrator"' "$manifest" 2>/dev/null
}

# Lanza un perfil: sin --patch si el plugin ya esta instalado en el; con --patch si no.
launch() {
  prof="$1"
  shift
  approval_default "$prof"
  if plugin_installed "$prof"; then
    run_dsh --profile "$prof" "$@"
  else
    run_dsh --profile "$prof" --patch "$ROOT/cordis.yml" "$@"
  fi
}

# Lanza la UI web anadiendo hosts de confianza (el fence /api compara la authority).
# Sin esto, abrir con `localhost` cuando el bind es `127.0.0.1` (o al reves) rompe el
# directory picker con "Failed to fetch".
launch_web() {
  case " $* " in
    *" --trusted-host "*) ;;
    *) set -- "$@" --trusted-host localhost --trusted-host 127.0.0.1 ;;
  esac
  launch web "$@"
}

case "${1:-}" in
  help|-h|--help)
    cat <<'EOF'
alfresco-dsh-horcas — agente de migracion de Alfresco (plugin dsh-alfresco-migrator) sobre DeepSeek Harness

INSTALAR (repo privado: gh autenticado o credenciales git)
  gh repo clone horelvis/dsh-alfresco-migrator ~/.local/share/alfresco-dsh-horcas -- --depth 1
  ~/.local/share/alfresco-dsh-horcas/install.sh
  # o, en un paso (bootstrap remoto autenticado con gh):
  curl -fsSL -H "Authorization: Bearer $(gh auth token)" \
    https://raw.githubusercontent.com/horelvis/dsh-alfresco-migrator/main/bootstrap.sh | sh
  # o, desde el repo ya clonado:
  ./install.sh                 dependencias + build + bundle en el perfil dsh + comando global
  cp .env.example .env         rellena credenciales del origen y modelo (o crea .env en tu proyecto)
  # sin instalar, desde el repo:  ./alfresco-dsh-horcas ...

EJECUTAR
  alfresco-dsh-horcas                 # abre la UI web (por defecto)
  alfresco-dsh-horcas web [--port 8080] [--no-open]
  alfresco-dsh-horcas headless "<tarea>"   # una tarea, no interactivo
  alfresco-dsh-horcas "analiza en solo lectura la migracion de data/projects/example.yaml"

CONFIGURACION (asi no hace falta pasar parametros en cada arranque)
  El lanzador carga, en este orden de menor a mayor prioridad:
    1) defaults internos (guardrail, sandbox read-only, estado, rutas, modelo),
    2) fichero de DEFAULTS GLOBALES: $ALFRESCO_DSH_HORCAS_ENV o ~/.config/alfresco-dsh-horcas/env,
    3) .env del WORKSPACE actual (el directorio desde el que invocas),
    4) variables exportadas en la linea de comandos (mandan siempre).
  Ej.: pon en el .env del workspace MIGRATOR_MODE=write y arranca solo con:  alfresco-dsh-horcas web
  Lanzalo EN el directorio de trabajo (donde vive el YAML del proyecto). Si no hay .env, se crea
  automaticamente desde .env.example; si no hay YAML, el agente lo crea con migrator_wizard.
  DSH_BIN (binario del arnes, p.ej. el fork) se EXPORTA al invocar o se pone en el fichero de defaults
  globales; NUNCA en el .env del workspace (el arnes lo rechaza: lo reserva el entorno que lo lanza).

MODO (seguridad determinista, no depende del prompt)
  Solo-lectura por defecto: las tools de ESCRITURA del migrador se DENIEGAN.
  Ensayo/cutover real: MIGRATOR_MODE=write (ademas de la aprobacion correspondiente).

APROBACION DE ESCRITURAS (MIGRATOR_APPROVAL)
  web:      interactive (defecto; aprueba en la UI) | deny | allowlist | allow
  headless: deny (defecto, fail-closed) | allowlist | allow

ALCANCE (guardrail solo-migracion, activo por defecto)
  Permite: lectura/inspeccion (read/glob/grep), ejecucion por shell (bash/pwsh), mutacion de
  ficheros (write/edit), orquestacion (subagent, todo, skill, jobs, goal) y preguntas al humano
  (ask_user_question). Deniega solo la red arbitraria (web_fetch/web_search).
  Desactivar: MIGRATOR_GUARDRAIL=false

SANDBOX DE FICHEROS (garantia de borrado, DSH_PERMISSION_MODE)
  read-only (defecto): cualquier escritura/borrado se bloquea y PIDE APROBACION humana.
  No usar workspace-write (borrados en el workspace sin preguntar) ni danger-full-access (sin aprobacion).
EOF
    exit 0
    ;;
  web|--web)
    shift
    launch_web "$@"
    ;;
  headless|--headless)
    shift
    [ "$#" -gt 0 ] || { usage; exit 2; }
    launch headless "$@"
    ;;
  "")
    # Sin argumentos: abre la UI web (UX recomendada).
    launch_web
    ;;
  *)
    [ "$#" -gt 0 ] || { usage; exit 2; }
    launch "${DSH_PROFILE:-headless}" "$@"
    ;;
esac
