# Configuracion local del migrador. Copia a `.env` y rellena.
# `.env` esta IGNORADO por git; NUNCA subas secretos.

# --- Estado y datos ---
MIGRATOR_STATE=.migrator
# MIGRATOR_DATA_DIR=./data

# --- Origen: API REST (Discovery) ---
MIGRATOR_SRC_USER=admin
MIGRATOR_SRC_PASSWORD=admin

# --- Origen: BD (solo SELECT read-only) ---
MIGRATOR_SRC_DB_URL=jdbc:postgresql://localhost:5432/alfresco
MIGRATOR_SRC_DB_USER=alfresco
MIGRATOR_SRC_DB_PASSWORD=alfresco

# --- Aprobacion de escrituras: deny (defecto) | allowlist | interactive | allow ---
MIGRATOR_APPROVAL=deny
# MIGRATOR_APPROVAL_ALLOW=migrator_run_steps,migrator_target

# --- Modelo del agente (OpenAI-compatible). El lanzador lo mapea a DEEPSEEK_* para dsh. ---
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENAI_API_KEY=
OPENAI_CHAT_OPTIONS_MODEL=deepseek-v4.1-flash
MIGRATOR_AI_SESSION=migrator-agent
# Anonimizacion hacia el LLM: SECRETS_ONLY (defecto, recomendado) | STANDARD | STRICT | OFF
MIGRATOR_AI_ANONYMIZATION=SECRETS_ONLY

# --- Overrides de comandos (entornos reales). Placeholders: {out} {in} {source} {target} ---
# MIGRATOR_DB_DUMP_CMD='docker exec -e PGPASSWORD=alfresco <pg-container> pg_dump -Fc -U alfresco -d alfresco > {out}'
# MIGRATOR_DB_RESTORE_CMD='docker exec -i -e PGPASSWORD=alfresco <dst-pg> pg_restore -c --if-exists -U alfresco -d alfresco < {in}'
# MIGRATOR_CONTENT_COPY_CMD='rsync -a "{source}/" "user@host:{target}/"'
# MIGRATOR_REINDEX_CMD='...'
# MIGRATOR_DST_PROVISION=auto   # auto | managed | external
