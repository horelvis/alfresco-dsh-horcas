# Configuracion local del migrador. Copia a `.env` y rellena.
# `.env` esta IGNORADO por git; NUNCA subas secretos.

# --- Estado y datos ---
MIGRATOR_STATE=.migrator
# MIGRATOR_DATA_DIR=./data

# --- Origen: API REST (Discovery) ---
MIGRATOR_SRC_USER=admin
MIGRATOR_SRC_PASSWORD=admin

# --- Origen: BD (solo SELECT read-only) ---
MIGRATOR_SRC_DB_URL=jdbc:postgresql://localhost:5432/alfresco
MIGRATOR_SRC_DB_USER=alfresco
MIGRATOR_SRC_DB_PASSWORD=alfresco

# --- Modo: readonly (defecto, escritura del migrador DENEGADA) | write ---
MIGRATOR_MODE=readonly

# --- Aprobacion de escrituras (solo en MIGRATOR_MODE=write): deny | allowlist | interactive | allow ---
MIGRATOR_APPROVAL=deny
# MIGRATOR_APPROVAL_ALLOW=migrator_run_steps,migrator_target

# --- Guardrail solo-migracion: permite lectura/orquestacion; deniega bash/escritura/web ---
MIGRATOR_GUARDRAIL=true
# Ampliar herramientas permitidas: MIGRATOR_GUARDRAIL_ALLOW=bash,read

# --- LLM (OpenAI-compatible). El lanzador lo mapea a DEEPSEEK_* para dsh. ---
# OJO: el modelo del AGENTE lo fija el arnes (`agent-default-model` = deepseek-official / deepseek-v4.1-flash,
# servido por el endpoint de abajo); `OPENAI_CHAT_OPTIONS_MODEL` solo alimenta la busqueda web.
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENAI_API_KEY=
OPENAI_CHAT_OPTIONS_MODEL=deepseek-v4.1-flash
MIGRATOR_AI_SESSION=migrator-agent
# Anonimizacion hacia el LLM: SECRETS_ONLY (defecto, recomendado) | STANDARD | STRICT | OFF
MIGRATOR_AI_ANONYMIZATION=SECRETS_ONLY

# --- Overrides de comandos (entornos reales). Placeholders: {out} {in} {source} {target} ---
# MIGRATOR_DB_DUMP_CMD='docker exec -e PGPASSWORD=alfresco <pg-container> pg_dump -Fc -U alfresco -d alfresco > {out}'
# MIGRATOR_DB_RESTORE_CMD='docker exec -i -e PGPASSWORD=alfresco <dst-pg> pg_restore -c --if-exists -U alfresco -d alfresco < {in}'
# MIGRATOR_CONTENT_COPY_CMD='rsync -a "{source}/" "user@host:{target}/"'
# MIGRATOR_REINDEX_CMD='...'
# MIGRATOR_DST_PROVISION=auto   # auto | managed | external
# Reindex 26.x CE (Search Community): el paso `reindex` siembra el cursor (watermark) del batch indexer.
# MIGRATOR_DST_SEARCH_URL=http://<host-destino>:9200   # si el motor es alcanzable desde el host (si no, se usa docker exec)
# MIGRATOR_DST_SEARCH_CONTAINER=<nombre>               # contenedor opensearch/elasticsearch (autodetectado por imagen)
# MIGRATOR_REINDEX_STATE_INDEX=alfresco-reindex-state  # indice de estado del cursor
# MIGRATOR_REINDEX_PREFIXES_FILE=./reindex.prefixes-file.json  # mapa completo de namespaces (se VALIDA; si faltan, bloquea)
